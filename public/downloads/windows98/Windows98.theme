; ============================================================
;  Windows 98 Classic Theme for Windows 11
;  Installed by Windows98.themepack - wallpaper, screensaver,
;  colors, cursors, sounds and desktop icons, all applied
;  automatically. Built entirely from components that ship
;  with Windows 11; fully reversible from Settings > Themes.
; ============================================================

[Theme]
DisplayName=Windows 98
ThemeId={89AB98C1-0625-4998-B98E-C0DE98C0FFEE}
SetLogonBackground=0

; Classic Windows 98 "Windows Standard" color scheme (R G B)
[Control Panel\Colors]
ActiveTitle=0 0 128
GradientActiveTitle=16 132 208
InactiveTitle=128 128 128
GradientInactiveTitle=181 181 181
TitleText=255 255 255
InactiveTitleText=192 192 192
ActiveBorder=192 192 192
InactiveBorder=192 192 192
WindowFrame=0 0 0
Window=255 255 255
WindowText=0 0 0
Background=0 128 128
AppWorkspace=128 128 128
Menu=192 192 192
MenuText=0 0 0
MenuBar=192 192 192
MenuHilight=0 0 128
Scrollbar=192 192 192
ButtonFace=192 192 192
ButtonText=0 0 0
ButtonShadow=128 128 128
ButtonHilight=255 255 255
ButtonDkShadow=0 0 0
ButtonLight=223 223 223
ButtonAlternateFace=181 181 181
GrayText=128 128 128
Hilight=0 0 128
HilightText=255 255 255
HotTrackingColor=0 0 128
InfoWindow=255 255 225
InfoText=0 0 0

; Desktop wallpaper. "Clouds" is applied by default; the pack also
; installs Teal, Blue Rivets, Waves and Sandstone alongside it -
; switch any time in Settings > Personalization > Background.
[Control Panel\Desktop]
Wallpaper=%LocalAppData%\Microsoft\Windows\Themes\Windows98\DesktopBackground\win98-clouds.png
TileWallpaper=0
WallpaperStyle=10
Pattern=
ScreenSaveActive=1

; Screensaver: Mystify - the classic "Mystify Your Mind" from
; Windows 98, still shipped with Windows 11
[boot]
SCRNSAVE.EXE=%SystemRoot%\system32\Mystify.scr

; Visual style: AeroLite (ships with Windows 11) renders squared
; window chrome and honors the classic caption colors, so title
; bars actually go navy. No third-party styling engine involved.
[VisualStyles]
Path=%SystemRoot%\resources\Themes\Aero\AeroLite.msstyles
ColorStyle=NormalColor
Size=NormalSize
AutoColorization=0
ColorizationColor=0XC4000080
Transparency=0
SystemMode=Light
AppMode=Light

; Desktop icons: bundled Win98-style pixel art (empty and full
; Recycle Bin states switch automatically, just like 1998)
[CLSID\{20D04FE0-3AEA-1069-A2D8-08002B30309D}\DefaultIcon]
DefaultValue=%LocalAppData%\Microsoft\Windows\Themes\Windows98\Icons\computer.ico,0

[CLSID\{645FF040-5081-101B-9F08-00AA002F954E}\DefaultIcon]
DefaultValue=%LocalAppData%\Microsoft\Windows\Themes\Windows98\Icons\recycle_empty.ico,0
Empty=%LocalAppData%\Microsoft\Windows\Themes\Windows98\Icons\recycle_empty.ico,0
Full=%LocalAppData%\Microsoft\Windows\Themes\Windows98\Icons\recycle_full.ico,0

[CLSID\{59031A47-3F72-44A7-89C5-5595FE6B30EE}\DefaultIcon]
DefaultValue=%LocalAppData%\Microsoft\Windows\Themes\Windows98\Icons\documents.ico,0

[CLSID\{F02C1A0D-BE21-4350-88B0-7367FC96EF3C}\DefaultIcon]
DefaultValue=%LocalAppData%\Microsoft\Windows\Themes\Windows98\Icons\network.ico,0

; Cursors: blank values select Windows' built-in classic scheme -
; the original black arrow and friends, no files needed
[Control Panel\Cursors]
AppStarting=
Arrow=
Crosshair=
Hand=
Help=
IBeam=
No=
NWPen=
Person=
Pin=
SizeAll=
SizeNESW=
SizeNS=
SizeNWSE=
SizeWE=
UpArrow=
Wait=
Link=
DefaultValue=Windows Standard

; Sounds: the Windows 98 event scheme, mapped from the legacy .wav
; files still shipped in C:\Windows\Media on Windows 11
[AppEvents\Schemes\Apps\.Default\.Default\.Current]
DefaultValue=%SystemRoot%\media\ding.wav

[AppEvents\Schemes\Apps\.Default\SystemAsterisk\.Current]
DefaultValue=%SystemRoot%\media\chord.wav

[AppEvents\Schemes\Apps\.Default\SystemExclamation\.Current]
DefaultValue=%SystemRoot%\media\chord.wav

[AppEvents\Schemes\Apps\.Default\SystemQuestion\.Current]
DefaultValue=%SystemRoot%\media\chord.wav

[AppEvents\Schemes\Apps\.Default\SystemHand\.Current]
DefaultValue=%SystemRoot%\media\chord.wav

[AppEvents\Schemes\Apps\.Default\SystemNotification\.Current]
DefaultValue=%SystemRoot%\media\notify.wav

; Startup / shutdown music ships in the pack. NOTE: Windows 11 no
; longer plays logon/logoff sound events by itself - run
; Extras\Enable-Win98-Extras.ps1 once to hear these at sign-in
; and shutdown.
[AppEvents\Schemes\Apps\.Default\SystemExit\.Current]
DefaultValue=%LocalAppData%\Microsoft\Windows\Themes\Windows98\Sounds\win98-shutdown.wav

[AppEvents\Schemes\Apps\.Default\WindowsLogon\.Current]
DefaultValue=%LocalAppData%\Microsoft\Windows\Themes\Windows98\Sounds\win98-startup.wav

[AppEvents\Schemes\Apps\.Default\WindowsLogoff\.Current]
DefaultValue=%LocalAppData%\Microsoft\Windows\Themes\Windows98\Sounds\win98-shutdown.wav

[AppEvents\Schemes\Apps\.Default\WindowsUnlock\.Current]
DefaultValue=%LocalAppData%\Microsoft\Windows\Themes\Windows98\Sounds\win98-startup.wav

[AppEvents\Schemes\Apps\Explorer\Navigating\.Current]
DefaultValue=%SystemRoot%\media\Windows Navigation Start.wav

[AppEvents\Schemes\Apps\Explorer\EmptyRecycleBin\.Current]
DefaultValue=%SystemRoot%\media\recycle.wav

; Required marker so Windows recognises this as a valid theme
[MasterThemeSelector]
MTSM=DABJDKT
