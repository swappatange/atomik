; ============================================================
;  Windows 98 Classic Theme for Windows 11
;  Recreates the classic Windows 98 look: silver-gray chrome,
;  navy title bars, the authentic teal desktop, classic black
;  cursors and the legacy system sounds still shipped with
;  Windows 11.
;
;  To apply: double-click this file on Windows 11.
; ============================================================

[Theme]
DisplayName=Windows 98
SetLogonBackground=0

; ------------------------------------------------------------
; Classic Windows 98 "Windows Standard" color scheme
; (values are R G B, straight from the Win98 defaults)
; ------------------------------------------------------------
[Control Panel\Colors]
ActiveTitle=0 0 128
GradientActiveTitle=16 132 208
InactiveTitle=128 128 128
GradientInactiveTitle=181 181 181
TitleText=255 255 255
InactiveTitleText=192 192 192
ActiveBorder=192 192 192
InactiveBorder=192 192 192
WindowFrame=0 0 0
Window=255 255 255
WindowText=0 0 0
Background=0 128 128
AppWorkspace=128 128 128
Menu=192 192 192
MenuText=0 0 0
MenuBar=192 192 192
MenuHilight=0 0 128
Scrollbar=192 192 192
ButtonFace=192 192 192
ButtonText=0 0 0
ButtonShadow=128 128 128
ButtonHilight=255 255 255
ButtonDkShadow=0 0 0
ButtonLight=223 223 223
ButtonAlternateFace=181 181 181
GrayText=128 128 128
Hilight=0 0 128
HilightText=255 255 255
HotTrackingColor=0 0 128
InfoWindow=255 255 225
InfoText=0 0 0

; ------------------------------------------------------------
; Desktop: no wallpaper file, so the classic solid teal
; (Background=0 128 128 above) shows through - exactly like a
; fresh Windows 98 install.
; ------------------------------------------------------------
[Control Panel\Desktop]
Wallpaper=
TileWallpaper=0
WallpaperStyle=10
Pattern=

; ------------------------------------------------------------
; Visual style: Windows 11 requires a modern .msstyles, so we
; use Aero in light mode tinted classic silver. (True 3D
; beveled window chrome no longer exists in Windows 11 - see
; the README for optional third-party tools that restore it.)
; ------------------------------------------------------------
[VisualStyles]
Path=%SystemRoot%\resources\themes\Aero\Aero.msstyles
ColorStyle=NormalColor
Size=NormalSize
AutoColorization=0
ColorizationColor=0XC4C0C0C0
SystemMode=Light
AppMode=Light

; ------------------------------------------------------------
; Cursors: blank values select the built-in classic scheme
; (the original black Windows arrow, hourglass-style wait etc.)
; ------------------------------------------------------------
[Control Panel\Cursors]
AppStarting=
Arrow=
Crosshair=
Hand=
Help=
IBeam=
No=
NWPen=
SizeAll=
SizeNESW=
SizeNS=
SizeNWSE=
SizeWE=
UpArrow=
Wait=
Link=
DefaultValue=Windows Standard

; ------------------------------------------------------------
; Sounds: the classic .wav files (ding, chord, tada, chimes...)
; still ship in C:\Windows\Media on Windows 11, so we can map
; the original Windows 98 sound scheme.
; ------------------------------------------------------------
[AppEvents\Schemes\Apps\.Default\.Default\.Current]
DefaultValue=%SystemRoot%\media\ding.wav

[AppEvents\Schemes\Apps\.Default\SystemAsterisk\.Current]
DefaultValue=%SystemRoot%\media\chord.wav

[AppEvents\Schemes\Apps\.Default\SystemExclamation\.Current]
DefaultValue=%SystemRoot%\media\chord.wav

[AppEvents\Schemes\Apps\.Default\SystemQuestion\.Current]
DefaultValue=%SystemRoot%\media\chord.wav

[AppEvents\Schemes\Apps\.Default\SystemHand\.Current]
DefaultValue=%SystemRoot%\media\chord.wav

[AppEvents\Schemes\Apps\.Default\SystemNotification\.Current]
DefaultValue=%SystemRoot%\media\notify.wav

[AppEvents\Schemes\Apps\.Default\SystemExit\.Current]
DefaultValue=%SystemRoot%\media\tada.wav

[AppEvents\Schemes\Apps\.Default\WindowsLogon\.Current]
DefaultValue=%SystemRoot%\media\tada.wav

[AppEvents\Schemes\Apps\.Default\WindowsLogoff\.Current]
DefaultValue=%SystemRoot%\media\chimes.wav

[AppEvents\Schemes\Apps\Explorer\EmptyRecycleBin\.Current]
DefaultValue=%SystemRoot%\media\recycle.wav

; Required marker so Windows recognises this as a valid theme
[MasterThemeSelector]
MTSM=DABJDKT
